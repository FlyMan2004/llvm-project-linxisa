# RUN: llc -mtriple=linx64 -run-pass=linx-blockify --linx-enable-mask-setc-fold -o - %s | FileCheck %s

# CHECK-LABEL: name: mask_fold_bne
# CHECK: BSTART_STD_COND %bb.1
# CHECK-NEXT: SETC_ANDI $r2, 255
# CHECK-NOT: CSETC_EQ

# CHECK-LABEL: name: mask_fold_beq
# CHECK: BSTART_STD_COND %bb.2
# CHECK-NEXT: SETC_ANDI $r2, 255
# CHECK-NOT: CSETC_EQ

--- |
  define i64 @mask_fold_bne(i64 %x) {
  entry:
    ret i64 0
  }

  define i64 @mask_fold_beq(i64 %x) {
  entry:
    ret i64 0
  }
...
---
name:            mask_fold_bne
alignment:       2
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
tracksRegLiveness: true
isSSA:           false
noVRegs:         true
liveins:
  - { reg: '$r2', virtual-reg: '' }
frameInfo:
  stackSize:       0
  adjustsStack:    false
  hasCalls:        false
  isCalleeSavedInfoValid: true
fixedStack:      []
stack:           []
body:             |
  bb.0:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $r2

    $r5 = ANDIri killed $r2, 255
    BNE $r5, $r0, %bb.1
    JUMP %bb.2

  bb.1:
    liveins: $r3

    $r2 = ADDIri $r0, 1
    PSEUDO_RET implicit $r10, implicit $r2, implicit $r3

  bb.2:
    liveins: $r3

    $r2 = ADDIri $r0, 0
    PSEUDO_RET implicit $r10, implicit $r2, implicit $r3
...
---
name:            mask_fold_beq
alignment:       2
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
tracksRegLiveness: true
isSSA:           false
noVRegs:         true
liveins:
  - { reg: '$r2', virtual-reg: '' }
frameInfo:
  stackSize:       0
  adjustsStack:    false
  hasCalls:        false
  isCalleeSavedInfoValid: true
fixedStack:      []
stack:           []
body:             |
  bb.0:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $r2

    $r5 = ANDIri killed $r2, 255
    BEQ $r5, $r0, %bb.1
    JUMP %bb.2

  bb.1:
    liveins: $r3

    $r2 = ADDIri $r0, 1
    PSEUDO_RET implicit $r10, implicit $r2, implicit $r3

  bb.2:
    liveins: $r3

    $r2 = ADDIri $r0, 0
    PSEUDO_RET implicit $r10, implicit $r2, implicit $r3
...
